{
  "name": "vpn-subscription-monitor",
  "version": "1.0.0",
  "description": "Local dashboard for monitoring sold VPN subscription URLs, traffic usage, and expiry dates.",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/ensure-dist.js && node server.js",
    "dev": "vite --configLoader runner",
    "dev:all": "node scripts/dev-all.js",
    "dev:server": "nodemon server.js",
    "dev:docs": "npm run start --workspace docs-site",
    "build:docs": "npm run build --workspace docs-site",
    "build": "vite build --configLoader runner && npm run build:docs && node scripts/write-build-meta.js",
    "check": "node --check server.js && vite build --configLoader runner --mode development && npm run build:docs",
    "migrate:customer-ids": "node scripts/migrate-customer-ids.js",
    "migrate:duration-days": "node scripts/migrate-duration-days.js",
    "sync:neon-to-local": "node scripts/sync-neon-to-postgres.js",
    "test": "node test.js",
    "test:payment": "node test-payment.js",
    "test:wallet": "node test-wallet.js"
  },
  "keywords": [
    "vpn",
    "subscription",
    "monitor",
    "shadowrocket",
    "clash"
  ],
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "docs-site"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-md-editor": "^4.1.1",
    "@vitejs/plugin-react": "^4.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "embla-carousel-react": "^8.6.0",
    "js-yaml": "^4.2.0",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "pinyin-pro": "^3.28.1",
    "radix-ui": "^1.6.2",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.81.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.2",
    "recharts": "^3.8.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "undici": "^8.6.0",
    "vaul": "^1.1.2",
    "vite": "^6.3.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite-plugin-compression": "^0.5.1"
  },
  "engines": {
    "node": ">=18"
  }
}
