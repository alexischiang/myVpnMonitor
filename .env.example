PORT=3000
LOG_LEVEL=info
# Local terminal formatting. Keep false in production so log collectors receive JSON.
LOG_PRETTY=false
PUBLIC_BASE_URL=https://your-domain.example
# 独立文档站（nexora-docs）：/docs/* 跳转到这里，并从 /api/announcements.json 读取公告。
DOCS_SITE_URL=https://docs.webprovider.top
# VPS 持久化 Markdown 图片目录。生产环境建议放在项目目录之外并纳入备份。
MARKDOWN_UPLOAD_DIR=/var/lib/myvpnmonitor/uploads/markdown
MARKDOWN_IMAGE_MAX_BYTES=8388608
REFRESH_INTERVAL_MS=86400000
REFRESH_CONCURRENCY=5
DATA_CACHE_TTL_MS=300000
RELAY_DEBUG_LOGS=false
LOW_TRAFFIC_BYTES=10737418240
EXPIRING_SOON_DAYS=7
# Relay URL selection window for generated customer subscription links.
RELAY_BEFORE_EXPIRY_DAYS=2
RELAY_AFTER_EXPIRY_DAYS=10
RELAY_MAX_CUSTOMERS=8
POOL_CONFIG_CACHE_TTL_MS=86400000
# 账户通知邮件（Gmail SMTP，需要应用专用密码 https://myaccount.google.com/apppasswords）
ALERT_EMAIL_FROM=alexischiangg@gmail.com
ALERT_EMAIL_PASS=****
ALERT_EMAIL_TO=alexischiangg@gmail.com
# Resend transaction email (optional). When configured, Resend is primary and Gmail SMTP is fallback.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_EMAIL_FROM=NEXORA <mail@your-domain.example>
# Telegram Bot（可选，用于支付通知和后台命令）
# TELEGRAM_BOT_TOKEN=123456:abcdef
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_WEBHOOK_SECRET=change-me
# TELEGRAM_PARSE_MODE=
# Payment gateway for public pricing checkout
PAYMENT_API_BASE_URL=http://RfBseViEKZlMAmu7ArWO.itxt002.xyz
PAYMENT_MERCHANT_ID=
PAYMENT_MERCHANT_SECRET=
# Fallback channel codes. Both can be changed from the admin payment settings page.
PAYMENT_CHANNEL_CODE=
PAYMENT_WECHAT_CHANNEL_CODE=200
# Optional. If empty, the server uses {current-origin}/api/payments/callback.
# In production, set an externally reachable HTTPS URL without query params.
PAYMENT_NOTIFY_URL=
# Optional. Browser return URL after payment. Use your public HTTPS pricing page in production.
PAYMENT_RETURN_URL=
# Optional percentage coupons: CODE:PERCENT, separated by commas.
# Optional seed used only when sales settings are first initialized.
PAYMENT_COUPONS=WELCOME10:10
# 可选：自定义 SMTP（默认走 smtp.gmail.com:465）
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=465
# ALERT_SMTP_SECURE=true
# PostgreSQL is required. LOCAL_DATABASE_URL overrides DATABASE_URL outside Vercel.
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true
# LOCAL_DATABASE_URL=postgresql://vpn_monitor:password@127.0.0.1:5432/vpn_monitor
# TEST_DATABASE_URL=postgresql://vpn_monitor:password@127.0.0.1:5432/vpn_monitor_test

# 3x-ui self-hosted test line. Clients use the registered account email and are attached to every inbound.
# XUI_BASE_URL=https://panel.example.com/<web-base-path>
# XUI_API_TOKEN=replace-with-api-token
# XUI_PANEL_NAME=主面板
# XUI_SUBSCRIPTION_BASE_URL=https://panel.webprovider.top:2096
# XUI_TIMEOUT_MS=15000
# Test environments should set this to true to block every 3x-ui API request outside the read allowlist.
# XUI_READ_ONLY=true
# Local 3x-ui service. Keep it on loopback; the main service is its only caller.
# XUI_SERVICE_URL=http://127.0.0.1:3002
# XUI_SERVICE_HOST=127.0.0.1
# XUI_SERVICE_PORT=3002
# XUI_SERVICE_TOKEN=replace-with-a-long-random-token
# Optional locally: when omitted, xui_* tables use LOCAL_DATABASE_URL. Production should use a separate database.
# XUI_DATABASE_URL=postgresql://vpn_monitor:password@127.0.0.1:5432/vpn_xui
# XUI_DATABASE_SSL=false
# REDIS_URL=redis://127.0.0.1:6379

# node-hub: controls xboard-node on each VPS (docs/agent/node-hub.md). Leave NODE_HUB_URL unset to keep 3x-ui only.
# Without XUI_BASE_URL the self-hosted line runs on node-hub alone; with both, users get 3x-ui and node-hub nodes.
# The app talks to the hub on loopback:
# NODE_HUB_URL=http://127.0.0.1:3003
# NODE_HUB_INTERNAL_TOKEN=replace-with-a-long-random-token
# NODE_HUB_SYNC_INTERVAL_MS=60000
# NODE_HUB_TIMEOUT_MS=10000
# The hub itself (npm run start:hub). It shares the app database (nh_* tables, xui_daily_traffic):
# NODE_HUB_DATABASE_URL=postgresql://vpn_monitor:password@127.0.0.1:5432/vpn_monitor
# NODE_HUB_HOST=127.0.0.1
# NODE_HUB_PORT=3003
# Public HTTPS address xboard-node reaches; expose only /api/v1/server/ and /api/v2/server/ through the reverse proxy.
# NODE_HUB_PUBLIC_URL=https://hub.example.com
# Installer used in the printed install command (default: upstream xboard-node install.sh):
# NODE_HUB_INSTALLER_URL=https://raw.githubusercontent.com/cedar2025/xboard-node/dev/install.sh
# Optional global token for single-node mode (machine mode uses per-machine tokens):
# NODE_HUB_SERVER_TOKEN=
# NODE_HUB_PUSH_INTERVAL=60
# NODE_HUB_PULL_INTERVAL=60
# WebSocket push to xboard-node at <NODE_HUB_PUBLIC_URL>/api/v2/server/ws (the proxy must allow upgrades there); false keeps REST polling only:
# NODE_HUB_WEBSOCKET=true
