{
  "name": "vpn-subscription-monitor",
  "version": "1.0.0",
  "description": "Local dashboard for monitoring sold VPN subscription URLs, traffic usage, and expiry dates.",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/ensure-dist.js && node server.js",
    "dev": "vite --configLoader runner",
    "dev:all": "node scripts/dev-all.js",
    "dev:server": "nodemon server.js",
    "build": "vite build --configLoader runner && node scripts/write-build-meta.js",
    "check": "node --check server.js && vite build --configLoader runner --mode development",
    "migrate:duration-days": "node scripts/migrate-duration-days.js",
    "migrate:json-to-db": "node scripts/migrate-json-to-db.js",
    "test": "node test.js"
  },
  "keywords": [
    "vpn",
    "subscription",
    "monitor",
    "shadowrocket",
    "clash"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@vitejs/plugin-react": "^4.6.0",
    "antd": "^6.4.3",
    "dayjs": "^1.11.21",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
