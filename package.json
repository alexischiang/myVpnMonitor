{
  "name": "vpn-subscription-monitor",
  "version": "1.0.0",
  "description": "Local dashboard for monitoring sold VPN subscription URLs, traffic usage, and expiry dates.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node scripts/write-build-meta.js",
    "check": "node --check server.js && node --check public/app.js",
    "migrate:duration-days": "node scripts/migrate-duration-days.js",
    "migrate:json-to-db": "node scripts/migrate-json-to-db.js",
    "test": "node test.js"
  },
  "keywords": [
    "vpn",
    "subscription",
    "monitor",
    "shadowrocket",
    "clash"
  ],
  "license": "UNLICENSED",
