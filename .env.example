PORT=3000
PUBLIC_BASE_URL=https://your-domain.example
REFRESH_INTERVAL_MS=1800000
LOW_TRAFFIC_BYTES=10737418240
EXPIRING_SOON_DAYS=7
# Relay URL selection window for generated customer subscription links.
RELAY_BEFORE_EXPIRY_DAYS=2
RELAY_AFTER_EXPIRY_DAYS=10
RELAY_MAX_CUSTOMERS=8
POOL_CONFIG_CACHE_TTL_MS=86400000
# 低流量邮件告警（Gmail SMTP，需要应用专用密码 https://myaccount.google.com/apppasswords）
ALERT_EMAIL_FROM=alexischiangg@gmail.com
ALERT_EMAIL_PASS=****
ALERT_EMAIL_TO=alexischiangg@gmail.com
# 剩余流量低于该值（字节）发送告警；默认 10 GB
ALERT_REMAINING_BYTES=10737418240
# 同一订阅的相邻两次告警最小间隔（毫秒）；默认 12 小时
ALERT_COOLDOWN_MS=43200000
# Telegram Bot alerts (optional; can be enabled together with email alerts)
# TELEGRAM_BOT_TOKEN=123456:abcdef
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_WEBHOOK_SECRET=change-me
# TELEGRAM_PARSE_MODE=
# Payment gateway for public pricing checkout
PAYMENT_API_BASE_URL=http://RfBseViEKZlMAmu7ArWO.itxt002.xyz
PAYMENT_MERCHANT_ID=
PAYMENT_MERCHANT_SECRET=
PAYMENT_CHANNEL_CODE=
# Optional. If empty, the server uses {current-origin}/api/payments/callback.
# In production, set an externally reachable HTTPS URL without query params.
PAYMENT_NOTIFY_URL=
# Optional. Browser return URL after payment. Use your public HTTPS pricing page in production.
PAYMENT_RETURN_URL=
# Optional percentage coupons: CODE:PERCENT, separated by commas.
PAYMENT_COUPONS=WELCOME10:10
# 可选：自定义 SMTP（默认走 smtp.gmail.com:465）
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=465
# ALERT_SMTP_SECURE=true
# Used only when DATABASE_URL is not set.
POOL_CACHE_DIR=./data/pool-cache
# DATA_FILE=./data/subscriptions.json
# 本地不填 DATABASE_URL 时继续使用 data/*.json。
# 云端部署 PostgreSQL 时填写，例如：
# DATABASE_URL
# DATABASE_SSL=true
